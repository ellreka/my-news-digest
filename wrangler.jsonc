{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my-news-digest",
	"compatibility_date": "2026-08-06",

	// 静的アセットのみ。Worker スクリプト（main）は不要
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},

	// TODO: 実ドメインに置換する（Cloudflare 上にゾーンが存在する必要あり）
	// "routes": [
	// 	{
	// 		"pattern": "news.example.com",
	// 		"custom_domain": true
	// 	}
	// ],

	// 現在の公開先は workers.dev（認証なしで閲覧可能と確認済み）。
	// 別途承認したドメイン / Access 設定の移行までは公開先を維持する。
	// preview URL のみ無効化（workers.dev 自体は有効）。
	"workers_dev": true,
	"preview_urls": false
}
